# Copy to .env and fill in. Every key here is FREE — none require payment.

# REQUIRED by SEC EDGAR fair-access policy: "Name email@domain" identifying you.
FA_SEC_USER_AGENT="Your Name you@example.com"

# FRED — free key at https://fred.stlouisfed.org/docs/api/api_key.html
# (the keyless fredgraph.csv endpoint times out on this network, so the key is needed for macro)
FA_FRED_API_KEY=

# Reddit — create a "script" app at https://www.reddit.com/prefs/apps (free)
FA_REDDIT_CLIENT_ID=
FA_REDDIT_CLIENT_SECRET=
FA_REDDIT_USER_AGENT="fa-analyzer/0.1 by your_reddit_username"

# Finnhub — optional, free tier at https://finnhub.io (60 req/min)
FA_FINNHUB_API_KEY=

# IBKR — IB Gateway / TWS API settings (Gateway paper=4002 live=4001, TWS paper=7497 live=7496)
FA_IB_HOST=127.0.0.1
FA_IB_PORT=4001
FA_IB_CLIENT_ID=17

# Schwab (thinkorswim) developer API — optional
FA_SCHWAB_APP_KEY=
FA_SCHWAB_APP_SECRET=
FA_SCHWAB_CALLBACK_URL=https://127.0.0.1:8182

# Data root (outside OneDrive!)
FA_DATA_ROOT=C:\fadata
